# ── Ports ────────────────────────────────────────────────────────────────────
# Host port the API is exposed on
API_PORT=4000

# Host port the frontend is exposed on
FE_PORT=3000

# ── API URL (required for deployments behind a real domain / IP) ──────────────
# The URL browsers use to reach the API.
# Must be reachable from the end-user's machine, not from inside Docker.
# Example: https://api.example.com  or  http://203.0.113.10:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin(s) the API allows. Should match the frontend's public URL.
# Example: https://app.example.com
CORS_ORIGIN=http://localhost:3000

# ── Auth (required) ─────────────────────────────────────────────────────────
# Signs and verifies session JWTs. Shared by the api (signs/verifies) and the
# frontend (verifies at the edge in middleware.ts). The API refuses to boot
# without it, and the previous hardcoded fallback was a complete auth bypass
# (see AUDIT-REPORT.md C1) — never leave this unset or reuse the dev value.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Public URLs used for OIDC redirects. Defaults to localhost if unset, which
# breaks OIDC login on a real domain (see AUDIT-REPORT.md C1).
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# ── Database ──────────────────────────────────────────────────────────────────
# Used by docker-compose to pass credentials into the db and api containers.
# DB_HOST is ignored in Docker (the api always connects to the 'db' service).
# Change DB_PASS to something strong before deploying to a real server.
DB_PASS=signalscope

# ── Device control (real/emulated/simulated device connectivity) ───────────────
# AES-256-GCM key used to encrypt device SSH/Telnet/SNMP credentials at rest
# in device_credentials.secret_encrypted. Required — the API refuses to boot
# without it. Generate with: openssl rand -hex 32
# Rotating this key invalidates every stored device credential (they'll need
# to be re-entered), same tradeoff as rotating JWT_SECRET.
CREDENTIAL_ENC_KEY=
